{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": { "pcl.js": ["./node_modules/pcl.js/dist/pcl.d.ts"] }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "viewer/**/*.ts",
    "benchmarks/**/*.ts",
    "vite.config.ts"
  ]
}
